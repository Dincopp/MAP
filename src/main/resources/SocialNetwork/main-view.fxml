<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="680.0" prefWidth="1120.0" styleClass="root-pane"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="SocialNetwork.controller.SocialNetworkController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="header-bar">
            <padding>
                <Insets bottom="12.0" left="18.0" right="18.0" top="12.0"/>
            </padding>
            <Label styleClass="app-title" text="Rețea de Socializare"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="currentUserLabel" styleClass="current-user-badge"
                   text="Utilizator curent: selectați un utilizator din tabel"/>
        </HBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.44" styleClass="main-split">
            <!-- Left Pane: Users Table (CRUD + Pagination) -->
            <VBox spacing="10.0" styleClass="panel-card">
                <padding>
                    <Insets bottom="14.0" left="14.0" right="14.0" top="14.0"/>
                </padding>
                <Label styleClass="section-title" text="Utilizatori"/>

                <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="userIdColumn" prefWidth="65.0" text="ID"/>
                        <TableColumn fx:id="userFirstNameColumn" prefWidth="170.0" text="Prenume"/>
                        <TableColumn fx:id="userLastNameColumn" prefWidth="170.0" text="Nume"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER" spacing="10.0">
                    <Button fx:id="prevUsersButton" onAction="#onUsersPrevious" styleClass="nav-button" text="◀ Anterior"/>
                    <Label fx:id="usersPageLabel" styleClass="page-label" text="Pagina 0 din 0"/>
                    <Button fx:id="nextUsersButton" onAction="#onUsersNext" styleClass="nav-button" text="Următor ▶"/>
                </HBox>

                <HBox alignment="CENTER" spacing="10.0">
                    <Button fx:id="addUserButton" onAction="#handleAddUser" styleClass="primary-button" text="Adaugă"/>
                    <Button fx:id="updateUserButton" onAction="#handleUpdateUser" styleClass="secondary-button" text="Modifică"/>
                    <Button fx:id="deleteUserButton" onAction="#handleDeleteUser" styleClass="danger-button" text="Șterge"/>
                </HBox>
            </VBox>

            <!-- Right Pane: Friends (Paginated) + Send Request + Received Requests -->
            <VBox spacing="14.0" styleClass="panel-card">
                <padding>
                    <Insets bottom="14.0" left="14.0" right="14.0" top="14.0"/>
                </padding>

                <!-- Friends Section -->
                <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                    <Label styleClass="section-title" text="Prietenii utilizatorului curent"/>
                    <TableView fx:id="friendsTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="friendIdColumn" prefWidth="65.0" text="ID"/>
                            <TableColumn fx:id="friendFirstNameColumn" prefWidth="190.0" text="Prenume"/>
                            <TableColumn fx:id="friendLastNameColumn" prefWidth="190.0" text="Nume"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Button fx:id="prevFriendsButton" onAction="#onFriendsPrevious" styleClass="nav-button" text="◀ Anterior"/>
                        <Label fx:id="friendsPageLabel" styleClass="page-label" text="Pagina 0 din 0"/>
                        <Button fx:id="nextFriendsButton" onAction="#onFriendsNext" styleClass="nav-button" text="Următor ▶"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="removeFriendButton" onAction="#handleRemoveFriend" styleClass="danger-button" text="Șterge prietenie"/>
                    </HBox>
                </VBox>

                <!-- Send Friend Request Section -->
                <VBox spacing="6.0" styleClass="sub-card">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                    </padding>
                    <Label styleClass="subsection-title" text="Trimite invitație de prietenie"/>
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <ComboBox fx:id="targetUserBox" prefWidth="320.0" promptText="Alege utilizator destinatar..." HBox.hgrow="ALWAYS"/>
                        <Button fx:id="sendRequestButton" onAction="#handleSendRequest" styleClass="primary-button" text="Trimite cerere"/>
                    </HBox>
                </VBox>

                <!-- Received Friend Requests Section -->
                <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                    <Label styleClass="section-title" text="Cereri de prietenie primite"/>
                    <TableView fx:id="requestsTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="requestIdColumn" prefWidth="55.0" text="ID"/>
                            <TableColumn fx:id="requestFromColumn" prefWidth="190.0" text="De la"/>
                            <TableColumn fx:id="requestStatusColumn" prefWidth="105.0" text="Status"/>
                            <TableColumn fx:id="requestDateColumn" prefWidth="140.0" text="Data"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                    <HBox alignment="CENTER_RIGHT" spacing="10.0">
                        <Button fx:id="acceptRequestButton" onAction="#handleAcceptRequest" styleClass="success-button" text="Acceptă"/>
                        <Button fx:id="rejectRequestButton" onAction="#handleRejectRequest" styleClass="danger-button" text="Respinge"/>
                    </HBox>
                </VBox>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>
